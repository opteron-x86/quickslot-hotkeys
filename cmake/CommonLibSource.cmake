# Standalone source-archive build with the same CommonLib lifetime override.
file(READ "${COMMONLIB_ROOT}/REVISION.txt" COMMONLIB_REV)
string(STRIP "${COMMONLIB_REV}" COMMONLIB_REV)
if(NOT COMMONLIB_REV STREQUAL "5decf47b01dde5501b03afaa91cd4d182e793cca")
  message(FATAL_ERROR "Expected the supplied alandtse/CommonLibSSE-NG 9.0.0 source")
endif()
set(QUICKSLOT_COMMONLIB_ROOT "${COMMONLIB_ROOT}")
set(QUICKSLOT_COMMONLIB_OVERLAY "${CMAKE_CURRENT_BINARY_DIR}/commonlib-overrides")
include("${CMAKE_CURRENT_LIST_DIR}/CommonLibHashMapPatch.cmake")
set(BUILD_TESTS OFF CACHE BOOL "CommonLib unit tests" FORCE)
set(ENABLE_SKYRIM_SE ON CACHE BOOL "CommonLib layout" FORCE)
set(ENABLE_SKYRIM_AE ON CACHE BOOL "CommonLib layout" FORCE)
set(ENABLE_SKYRIM_VR ON CACHE BOOL "CommonLib layout" FORCE)
set(SKSE_SUPPORT_PATCH_SAFETY ON CACHE BOOL "CommonLib patch checks" FORCE)
set(COMMONLIB_PREBUILT OFF CACHE BOOL "Build patched CommonLib from source" FORCE)
set(COMMONLIB_PREBUILT_DIR "" CACHE PATH "Build patched CommonLib from source" FORCE)
set(FETCHCONTENT_SOURCE_DIR_HDE64 "${QUICKSLOT_VENDOR_DIR}/minhook" CACHE PATH "Bundled MinHook decoder source" FORCE)
add_subdirectory("${COMMONLIB_ROOT}" "${CMAKE_CURRENT_BINARY_DIR}/commonlib" EXCLUDE_FROM_ALL)
get_target_property(QUICKSLOT_COMMONLIB_IMPORTED CommonLibSSE IMPORTED)
if(QUICKSLOT_COMMONLIB_IMPORTED)
  message(FATAL_ERROR "A prebuilt CommonLib cannot supply the required lifetime fix")
endif()
target_include_directories(CommonLibSSE BEFORE PUBLIC "$<BUILD_INTERFACE:${QUICKSLOT_COMMONLIB_OVERLAY}>")
foreach(QUICKSLOT_DEFINITIONS COMPILE_DEFINITIONS INTERFACE_COMPILE_DEFINITIONS)
  get_target_property(QUICKSLOT_COMMONLIB_DEFINITIONS CommonLibSSE ${QUICKSLOT_DEFINITIONS})
  list(FILTER QUICKSLOT_COMMONLIB_DEFINITIONS EXCLUDE REGEX "^(WINVER|_WIN32_WINNT)=")
  list(APPEND QUICKSLOT_COMMONLIB_DEFINITIONS WINVER=0x0A00 _WIN32_WINNT=0x0A00)
  set_property(TARGET CommonLibSSE PROPERTY ${QUICKSLOT_DEFINITIONS} "${QUICKSLOT_COMMONLIB_DEFINITIONS}")
endforeach()
target_compile_options(CommonLibSSE PRIVATE /Brepro)
